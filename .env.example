# Copie a .env (cp .env.example .env). Solo variables VITE_ llegan al navegador: nunca ponga secretos.

# API local (docker compose en spa-backend-api) o la de staging:
# https://spa-unas-api-git-develop-spa-a68d.vercel.app/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# true = trabaja sin backend con datos simulados (src/mocks). Usuarios: admin@spa.co,
# manicurista@spa.co, gerente@spa.co · contraseña spa12345
VITE_API_MOCK=true
